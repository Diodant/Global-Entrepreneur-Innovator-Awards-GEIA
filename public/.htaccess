<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve existing files and directories without rewriting them.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Serve prerendered SEO HTML when a matching route file exists.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]

  # Let React Router handle all other application routes.
  RewriteRule ^ index.html [L]
</IfModule>
